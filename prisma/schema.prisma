// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Oficina {
  id        Int       @id @default(autoincrement())
  nombre    String
  direccion String?
  empleados Empleado[]
  activos   Activo[]
}

model Empleado {
  id         Int      @id @default(autoincrement())
  nombre     String
  cargo      String?
  oficina    Oficina  @relation(fields: [oficinaId], references: [id])
  oficinaId  Int
  activos    Activo[]
}

model Activo {
  id                Int       @id @default(autoincrement())
  codigo            String    @unique
  tipo              String
  ip                String?
  macAddress        String?
  puertoRed         String?
  departamento      String?
  marca             String?
  claseEquipo       String?
  numeroSerie       String?
  monitor           String?
  serieMonitor      String?
  codigoContable    String?
  parlantes         String?
  placaMadre        String?
  procesador        String?
  ram               String?
  disco             String?
  estadoRaton       String?
  estadoTeclado     String?
  estadoDisco       String?
  sistemaOperativo  String?
  mantenimiento     String?
  actualizable      String?
  anydesk           String?
  upgrade           String?
  recomendacion     String?
  saleA             String?
  entraA            String?
  estado            String    @default("activo")
  antivirus         String?
  criterio          String?
  oficina           Oficina   @relation(fields: [oficinaId], references: [id])
  oficinaId         Int
  responsable       Empleado? @relation(fields: [responsableId], references: [id])
  responsableId     Int?
  createdAt         DateTime  @default(now())
}