// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Oficina {
  id        Int       @id @default(autoincrement())
  nombre    String
  direccion String?
  empleados Empleado[]
  activos   Activo[]
  color     String?
}

model Empleado {
  id         Int      @id @default(autoincrement())
  nombre     String
  cargo      String?
  correo     String?
  oficina    Oficina  @relation(fields: [oficinaId], references: [id])
  oficinaId  Int
  usuario       Usuario? @relation("UsuarioEmpleado")
  activos    Activo[]
}

model Activo {
  id                Int       @id @default(autoincrement())
  codigo            String    @unique
  tipo              String
  ip                String?
  macAddress        String?
  puertoRed         String?
  departamento      String?
  marca             String?
  claseEquipo       String?
  numeroSerie       String?
  monitor           String?
  serieMonitor      String?
  codigoContable    String?
  costo             Float?
  parlantes         String?
  placaMadre        String?
  procesador        String?
  ram               String?
  disco             String?
  estadoRaton       String?
  estadoTeclado     String?
  estadoDisco       String?
  sistemaOperativo  String?
  mantenimiento     String?
  actualizable      String?
  anydesk           String?
  upgrade           String?
  recomendacion     String?
  saleA             String?
  entraA            String?
  estado            String    @default("activo")
  antivirus         String?
  criterio          String?
  oficina           Oficina   @relation(fields: [oficinaId], references: [id])
  oficinaId         Int
  responsable       Empleado? @relation(fields: [responsableId], references: [id])
  responsableId     Int?
  cargador          String?
  tecladoSerial     String?
  mouseSerial       String?
  adaptadorCorriente String?
  impresoraConfigurada String?
  serialImpresora   String?
  macComputador     String?
  telefonoMarcaModelo String?
  ipTelefono        String?
  macTelefono       String?
  seguroLaptop      String?
  softwareSO             String?
  softwareCorporativo    String?
  softwareOtros          String?
  createdAt         DateTime  @default(now())
    eliminado         Boolean   @default(false)
  fechaEliminado    DateTime?
  
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nombre    String
  correo    String   @unique
  password  String
  rol       String   @default("tecnico")
  createdAt DateTime @default(now())
  empleadoId    Int?     @unique
  empleado      Empleado? @relation("UsuarioEmpleado", fields: [empleadoId], references: [id])
}

model PlantillaActa {
  id                Int      @id @default(autoincrement())
  codigo            String   @default("FO-TI-009")
  version           String   @default("001")
  fechaAprobacion   String   @default("")
  responsable       String   @default("Coordinador TICs")
  tituloDocumento   String   @default("ACTA DE ENTREGA DE EQUIPOS DE COMPUTO")
  clausula          String   @default("Certifico que los elementos detallados en el presente documento, me han sido entregados para mi cuidado y custodia con el propósito de cumplir con las tareas y asignaciones propias de mi cargo en la agencia, siendo estos de mi única y exclusiva responsabilidad. Me comprometo a usar correctamente los recursos, y solo para los fines establecidos, a no instalar ni permitir la instalación de software por personal ajeno al grupo interno de trabajo de soporte de TI.")
  observaciones     String   @default("Esta acta se entregará a partir de la revisión y mantenimiento del equipo.")
  listaSoftware     String   @default("Windows 10 PRO,Windows 11 PRO,Office 365 (Teams, Outlook, Word, Excel, etc.),Onedrive,Adobe Reader DC,Google Chrome,Compresor WinRAR,Anydesk,Forticlient,Pardus QQ,Zoom,Webex,R Studio,Filezilla,SafeNet (Token BCE),Firma EC,WebClientPrint,Mozilla Firefox")
  updatedAt         DateTime @updatedAt
}

model HistorialActivo {
  id        Int      @id @default(autoincrement())
  activoId  Int
  accion    String
  detalle   String?
  usuario   String
  fecha     DateTime @default(now())
}